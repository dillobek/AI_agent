# ===========================================
# AI Personal Assistant Ecosystem - Environment
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ===========================================

# ---- App ----
NODE_ENV=development
PORT=3000
# Used by Caddy to issue and renew HTTPS certificates for aipixel.uz.
ACME_EMAIL=admin@aipixel.uz

# Optional modules (safe defaults)
TELEGRAM_ENABLED=false
# Owner-only Control Bot (above) and personal account automation (below) are
# intentionally separate. Keep the Control Bot enabled for /pause,/resume.
PERSONAL_TELEGRAM_ENABLED=false
INSTAGRAM_ENABLED=false
GOOGLE_DRIVE_ENABLED=false
OBSIDIAN_ENABLED=false
RAG_ENABLED=false
N8N_ENABLED=false
FINANCE_MODULE_ENABLED=true
PATIENTS_MODULE_ENABLED=true
DASHBOARD_ENABLED=true
# Real-time voice assistant ("Ali"). Gates only the /voice endpoints and
# the dashboard voice UI. Requires OPENAI_API_KEY below.
VOICE_ENABLED=false
# Separate flags: these agent tools are also useful from the existing text
# chat, independent of whether the voice UI is on.
YOUTUBE_ENABLED=false
CALENDAR_ENABLED=false

# ---- Database (PostgreSQL + Prisma) ----
POSTGRES_USER=ai_assistant
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ai_assistant_db
DATABASE_URL="postgresql://ai_assistant:change_me_strong_password@localhost:5432/ai_assistant_db?schema=public"

# ---- JWT (Dashboard Auth) ----
JWT_SECRET=change_me_super_secret_jwt_key
JWT_EXPIRES_IN=1d
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
OTP_TTL_MINUTES=5

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=123456789:AAExampleTelegramBotTokenXXXXXXXXXXXXX
# Comma-separated list of authorized Telegram numeric user IDs
TELEGRAM_WHITELIST_IDS=123456789,987654321

# ---- Personal Telegram account automation (MTProto) ----
# Create API ID/HASH at https://my.telegram.org. The phone login code is
# entered once on the VPS setup flow; never put an OTP/password in this file.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
PERSONAL_TELEGRAM_PHONE=
# Generated encrypted session (not a plain StringSession); leave empty before first setup.
PERSONAL_TELEGRAM_SESSION=
# Generate: openssl rand -base64 48. Required for encrypted session at rest.
PERSONAL_TELEGRAM_SESSION_ENCRYPTION_KEY=
PERSONAL_REPLY_MAX_HISTORY=24
# Set true only if every AI-requested outgoing personal message must require
# an explicit /confirm code. False sends after one unambiguous contact match.
PERSONAL_TELEGRAM_REQUIRE_CONFIRMATION=false
# Keep false unless you explicitly want private-message text mirrored to n8n.
# The connector always stores the message locally; this controls webhook sync.
N8N_PERSONAL_TELEGRAM_SYNC=false
# POST JSON {"prompt":"..."} and return JSON {"imageUrl":"https://..."}.
# An n8n workflow is recommended to connect your preferred image provider.
CHANNEL_IMAGE_GENERATION_WEBHOOK_URL=

# ---- OpenAI AI Engine ----
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_PROVIDER=openai
AGENT_MAX_TOOL_CALLS=6
AGENT_TOOL_TIMEOUT_MS=15000
AGENT_MAX_PROMPT_CHARS=8000
AGENT_MAX_TOOL_OUTPUT_CHARS=6000
SESSION_TTL_MINUTES=60

# ---- Google Drive API ----
# Path to the Google Cloud service-account JSON key file (see README for setup steps)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_PAGE_SIZE=25

# ---- Obsidian Local REST API ----
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=change_me_obsidian_local_rest_api_key
OBSIDIAN_ALLOW_INSECURE_TLS=false
OBSIDIAN_REQUEST_TIMEOUT_MS=10000
# Vault-relative path for today's daily note ("{date}" -> YYYY-MM-DD), used
# by the voice/agent get_today_plan tool. Change the folder to match your vault.
OBSIDIAN_DAILY_NOTE_PATH_TEMPLATE={date}.md

# ---- Vector Store (RAG) ----
# "chroma" or "pgvector"
VECTOR_STORE_PROVIDER=chroma
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=patient_knowledge_base
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_SCORE_THRESHOLD=0.3

# ---- Finance / Gmail Webhook Integration ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
FINANCE_WEBHOOK_SECRET=change_me_webhook_signing_secret
FINANCE_WEBHOOK_MAX_BODY_BYTES=65536
FINANCE_WEBHOOK_REPLAY_WINDOW_SECONDS=300

# ---- Anti Rate-Limit Delay (ms) ----
API_CALL_DELAY_MIN_MS=1000
API_CALL_DELAY_MAX_MS=2000
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=300
LOG_RETENTION_DAYS=30
LOG_LEVEL=log
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# ---- Dashboard Frontend ----
# Production: https://ser.aipixel.uz
DASHBOARD_CORS_ORIGIN=http://localhost:5173

# ---- Voice assistant (OpenAI Realtime, over WebRTC) ----
# The browser holds a WebRTC connection straight to OpenAI, so audio never
# passes through this API — but OPENAI_API_KEY never reaches the browser
# either: the SDP handshake is proxied by POST /voice/realtime-call, which
# is also where the agent's tool registry is attached to the session.
# Realtime model IDs are versioned ("gpt-realtime-2.1"); the unsuffixed
# alias below tracks the current one.
OPENAI_REALTIME_MODEL=gpt-realtime
# Output voice. Cannot change once the model has spoken in a session.
OPENAI_REALTIME_VOICE=cedar
# Transcribes the user's own speech. Without it, only the assistant's half
# of the conversation appears in the transcript.
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# ISO-639-1 hint for that transcriber. Leave empty to auto-detect.
# Leave empty for automatic language detection (Whisper does not accept `uz`).
VOICE_LANGUAGE=

# ---- Voice assistant (legacy Gemini Live path) ----
# Unused while AI_PROVIDER=openai; kept so an older .env still validates.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
VOICE_LIVE_TOKEN_TTL_SECONDS=1800

# ---- YouTube search (voice/agent "play a video" tool) ----
# https://console.cloud.google.com/apis/credentials -> API key, then enable
# the "YouTube Data API v3" for that project.
YOUTUBE_API_KEY=

# ---- Google Calendar (voice/agent "today's plan" tool) ----
# Share this calendar with the GOOGLE_APPLICATION_CREDENTIALS service
# account's client_email (Settings and sharing -> Share with specific
# people -> "Make changes to events"), same pattern as the Drive folder
# above. Then put the calendar's ID here (your own email address for the
# primary calendar, or the "Calendar ID" from that calendar's settings).
GOOGLE_CALENDAR_ID=

# ---- n8n Workflow Automation ----
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Tashkent
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_strong_password
# The exact n8n Webhook node URL this API should POST outbound events to
# (create the webhook in n8n first, then paste its URL here).
N8N_OUTBOUND_WEBHOOK_URL=http://localhost:5678/webhook/ai-assistant-events
# Shared secret n8n must send in the "x-n8n-secret" header when calling
# this API's POST /n8n/trigger endpoint. Generate with: openssl rand -hex 32
N8N_INBOUND_SECRET=change_me_long_random_shared_secret
